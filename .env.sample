# NaraRouter — API credentials
NARA_API_KEY=sk-nry-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API base URL (usually default is fine)
NARA_BASE_URL=https://router.bynara.id/v1

# Planner models — first is primary, rest are fallbacks
NARA_MODEL=nemotron-3-super-free,agnes-2.5-flash

# Vision models — same pattern
NARA_VISION_MODEL=nex-n2.5-pro,agnes-2.5-flash

# Max tool-call steps per task
NARA_MAX_STEPS=20

# Require confirmation before running shell commands (1/0)
NARA_CONFIRM=1

# Cost rates in Rp per 1M tokens (optional, for logging only)
NARA_PRICE_IN=0
NARA_PRICE_OUT=0
